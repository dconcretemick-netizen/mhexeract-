# Copy to .env (never commit it) and export before running, e.g.  set -a; . ./.env; set +a
# Any subset works: the gateway only routes to providers whose keys are present.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# Google Vertex AI uses Application Default Credentials (gcloud auth application-default login)
# or a service-account file:
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=

# Optional
GATEWAY_LITE=0          # 1 = stdlib-only Android mode (OpenRouter, plus direct OpenAI/DeepSeek)
GATEWAY_MOCK=0          # 1 = offline mock responses, no keys needed
GATEWAY_DB=gateway_usage.db
GATEWAY_GUI_TOKEN=      # required token for the GUI when served on 0.0.0.0

# MHexeract is free by default: only no-card free plans (Gemini, Groq, Mistral, SambaNova, NVIDIA, Hugging Face,
# Cohere trial, OpenRouter :free models) and local models are used. Set MHEXERACT_ALLOW_PAID=1 to allow paid AI.
MHEXERACT_ALLOW_PAID=0
# More AI nodes: any of these keys adds that provider's models automatically (see `nodes scan`)
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
HF_TOKEN=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPINFRA_API_KEY=
NOVITA_API_KEY=
HYPERBOLIC_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
ZAI_API_KEY=
MINIMAX_API_KEY=
COHERE_API_KEY=
MHEXERACT_NODES=           # extra trusted OpenAI-compatible servers, comma separated base URLs
MHEXERACT_NODE_SCAN=1      # 0 = never look for new nodes
MHEXERACT_LAN_SCAN=1       # 0 = only this device and cloud providers, skip the local network

# Optional fine-grained GitHub token (read-only). Updates work without it now the repo is public.
GITHUB_TOKEN=
